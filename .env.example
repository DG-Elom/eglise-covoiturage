# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx
SUPABASE_SERVICE_ROLE_KEY=xxx

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=pk.xxx

# Anthropic (IA)
ANTHROPIC_API_KEY=sk-ant-xxx

# Google Gemini (IA — suggestions de pickup)
GEMINI_API_KEY=your_gemini_api_key_here

# Resend (emails)
RESEND_API_KEY=re_xxx

# Brevo (SMS transactionnels, FR)
# BREVO_API_KEY : créer une clé sur https://app.brevo.com/settings/keys/api
# BREVO_SMS_SENDER : 11 caractères max, alphanumérique sans espace ni accent
BREVO_API_KEY=xkeysib-xxx
BREVO_SMS_SENDER=ICCcovoit

# Push notifications internes (Edge Functions → Next.js)
# Générer via : openssl rand -base64 32
INTERNAL_PUSH_SECRET=xxx

# URL de l'app (utilisé par les Edge Functions Deno pour appeler /api/internal/send-push)
APP_URL=https://app.icc-covoit.fr

# Bug reports : email qui recoit les notifications de bugs
BUG_REPORT_EMAIL=admin@example.com
